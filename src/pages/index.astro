<Base title="Malek Asfeer · Creative Director and Filmmaker" description="Malek Asfeer, creative director and filmmaker in Denver. Founding teams at Charlotte's Web and AJNA BioSciences, interim VP Creative at Igniton, founder of 35 FILM.">
  <div id="site" class="site">
    <Nav />
    <main>
      <Opening />
      <Story />
      <Work />
      <Stats />
      <Strengths />
      <Grow />
      <Motion />
      <Films />
      <Closing />
    </main>
    <Cases />
  </div>
</Base>
